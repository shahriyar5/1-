            let orders = [];
            try {
                orders = JSON.parse(localStorage.getItem('shipping_orders') || '[]');
            } catch(e) {
                orders = [];
            }
            
            orders.push(order);
            localStorage.setItem('shipping_orders', JSON.stringify(orders));
        }

